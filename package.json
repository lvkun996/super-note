{
  "name": "super-note",
  "version": "0.1.12",
  "private": true,
  "description": "编辑你的世界",
  "author": "kunkun",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "cache:packager": "node scripts/cache-packager-deps.mjs",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "node scripts/verify-packaged-app.mjs",
    "pack": "node scripts/build-installer.mjs --dir",
    "dist": "node scripts/build-installer.mjs",
    "dist:win7-8": "node scripts/build-installer.mjs --win7-8",
    "release:full": "node scripts/release.mjs",
    "release:current": "node scripts/release.mjs --no-win7-8"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.24.1",
    "electron-updater": "^6.8.9",
    "fs-extra": "^10.1.0",
    "jsonfile": "^6.2.1",
    "markdown-it": "^14.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semver": "~7.7.3",
    "universalify": "^2.0.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.supernote.desktop",
    "productName": "Super Note",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Super.Note.Setup.${version}.${ext}",
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
